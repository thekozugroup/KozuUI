  "feedback": {
    "listening": {
      "rows": 3,
      "phaseDelayMs": 550,
      "transitionMs": 110,
      "reducedMotion": "steady matrix with Listening label and Stop action",
      "wide": {
        "trackSizing": "fill",
        "preferredColumnPitch": 8,
        "dotDiameter": 4,
        "maxRows": 7,
        "stopTarget": 48,
        "narrowLayout": "stack when the label and control would crowd the waveform"
      }
    },
    "progress": {
      "rows": 2,
      "value": "show the exact percent next to the grid",
      "labelSize": 14,
      "valueSize": 14,
      "sideInset": 20,
      "sideSlot": 60,
      "trackSizing": "fill remaining width"
    },
    "goal": {
      "min": 0,
      "max": 100,
      "fill": "saved / target",
      "label": "numeric value and saved amount"
    },
    "dotGrid": {
      "diameter": 4,
      "pitch": 8,
      "gap": 4,
      "alignment": "center",
      "columnCount": "W < 4 ? 0 : 1 + floor((W - 4) / 8)",
      "quantization": "Draw whole circles only. Fill floor(totalDots * percent / 100) dots, column by column from the leading edge. Report the exact numeric value independently."
    }
  },
