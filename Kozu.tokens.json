{
  "name": "Kozu UI",
  "version": "1.0.0",
  "units": "logical units; web lengths in CSS pixels",
  "colors": {
    "paper/canvas": "#F7F7F7",
    "paper/sheet": "#FFFFFF",
    "paper/control": "#F5F5F5",
    "paper/subtle": "#FAFAFA",
    "paper/ink": "#090B14",
    "paper/secondary": "#575A64",
    "paper/quiet": "#696C76",
    "blue/depth": "#14295F",
    "blue/mid": "#345A98",
    "blue/light": "#79A3DD",
    "smoke/ground": "#090F19",
    "smoke/panel": "#101A2AC2",
    "smoke/surface": "#0B14239E",
    "smoke/content": "#F5F7FC",
    "smoke/secondary": "#BAC6DA",
    "smoke/soft": "#CEDBF0",
    "console/ground": "#020908",
    "console/panel": "#041916CD",
    "console/ink": "#F1F5F1",
    "console/metadata": "#ACBCB5",
    "console/acid": "#BFDF38",
    "status/alert": "#FF9765",
    "status/information": "#ABC1FF",
    "status/resolved": "#A7D5A4",
    "paper/input": "#F0F1F3",
    "blue/on-field": "#DCE8FD",
    "smoke/opaque": "#1B2634",
    "smoke/selection": "#D4E6FF",
    "console/opaque": "#17231A",
    "console/on-acid": "#1A240D",
    "paper/active-bar": "#14151A",
    "paper/inactive-bar": "#CCCCD0",
    "blue/selection": "#DDE8FA",
    "smoke/muted-grid": "#728195"
  },
  "dimensions": {
    "blur/control": 28,
    "blur/overlay": 40,
    "radius/control": 24,
    "radius/panel": 28,
    "radius/sheet": 32,
    "radius/small": 14,
    "target/touch": 48,
    "target/pointer": 32
  },
  "cssRoles": {
    "--kozu-paper": "paper/canvas",
    "--kozu-paper-raised": "paper/sheet",
    "--kozu-paper-input": "paper/input",
    "--kozu-paper-ink": "paper/ink",
    "--kozu-paper-muted": "paper/secondary",
    "--kozu-blue-base": "blue/depth",
    "--kozu-blue-light": "blue/light",
    "--kozu-blue-action": "blue/mid",
    "--kozu-blue-ink": "smoke/content",
    "--kozu-blue-muted": "blue/on-field",
    "--kozu-smoke-base": "smoke/ground",
    "--kozu-smoke-panel": "smoke/opaque",
    "--kozu-smoke-frost": "smoke/panel",
    "--kozu-smoke-ink": "smoke/content",
    "--kozu-smoke-muted": "smoke/secondary",
    "--kozu-smoke-active": "smoke/selection",
    "--kozu-night-base": "console/ground",
    "--kozu-night-panel": "console/opaque",
    "--kozu-night-frost": "console/panel",
    "--kozu-night-ink": "console/ink",
    "--kozu-night-muted": "console/metadata",
    "--kozu-acid": "console/acid",
    "--kozu-acid-ink": "console/on-acid"
  },
  "materials": {
    "blue": {
      "asset": "Assets/Materials/blue.jpg",
      "size": [
        1080,
        1350
      ],
      "description": "Deep cobalt upper right; lighter mid-blue across the left and lower field. Fine paper grain."
    },
    "story": {
      "asset": "Assets/Materials/story.jpg",
      "size": [
        1080,
        1350
      ],
      "description": "Cobalt and diffuse blue over the upper half, graduating to #060912 ink by the bottom fifth."
    },
    "smoke": {
      "asset": "Assets/Materials/smoke.jpg",
      "size": [
        1080,
        1350
      ],
      "description": "Dark left half with soft diagonal bands falling toward bottom right. Icy-blue light peaks at the right edge."
    },
    "agents": {
      "asset": "Assets/Materials/agents.jpg",
      "size": [
        1080,
        1350
      ],
      "description": "Broad diagonal bands rise into a spectral blue-white light source beyond the upper-right edge. Dark lower half."
    },
    "acid": {
      "asset": "Assets/Materials/acid.jpg",
      "size": [
        1080,
        1350
      ],
      "description": "Chartreuse through emerald and dark teal to black. Colored square screen at 4.7 logical units pitch."
    },
    "night": {
      "asset": "Assets/Materials/night.jpg",
      "size": [
        1080,
        1350
      ],
      "description": "Warm olive light at the top, diagonal moss bands and a muted center/right. Colored square screen at 4.7 logical units pitch."
    }
  },
  "portraits": [
    "Assets/People/alex.jpg",
    "Assets/People/oliver.jpg",
    "Assets/People/james.jpg"
  ],
  "typography": {
    "families": {
      "interface": [
        "Inter",
        "system-ui",
        "sans-serif"
      ],
      "workspace": [
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "telemetry": [
        "Menlo",
        "ui-monospace",
        "monospace"
      ]
    },
    "styles": {
      "Display / Title": {
        "family": "Inter",
        "weight": "Medium",
        "size": 48,
        "lineHeight": 55.68,
        "trackingPercent": -3
      },
      "Display / Balance": {
        "family": "Inter",
        "weight": "Regular",
        "size": 40,
        "lineHeight": 46.4,
        "trackingPercent": -3
      },
      "Heading / Section": {
        "family": "Inter",
        "weight": "SemiBold",
        "size": 24,
        "lineHeight": 27.84,
        "trackingPercent": -1
      },
      "Body / Standard": {
        "family": "Inter",
        "weight": "Regular",
        "size": 16,
        "lineHeight": 18.56,
        "trackingPercent": 0
      },
      "Control / Label": {
        "family": "Inter",
        "weight": "Medium",
        "size": 14,
        "lineHeight": 16.24,
        "trackingPercent": 0
      },
      "Label / Caption": {
        "family": "Inter",
        "weight": "Medium",
        "size": 12,
        "lineHeight": 13.92,
        "trackingPercent": 0
      },
      "Workspace / Body": {
        "family": "Helvetica Neue",
        "weight": "Regular",
        "size": 14,
        "lineHeight": 16.24,
        "trackingPercent": 0
      },
      "Workspace / Title": {
        "family": "Helvetica Neue",
        "weight": "Medium",
        "size": 18,
        "lineHeight": 20.88,
        "trackingPercent": 0
      },
      "Console / Timestamp": {
        "family": "Menlo",
        "weight": "Regular",
        "size": 12,
        "lineHeight": 13.92,
        "trackingPercent": 0
      }
    },
    "numbers": "Enable tnum for changing values, timestamps, and aligned currency. Keep signs, decimal separators and fractions in the same reading order."
  },
  "surface": {
    "paylane": {
      "ground": "blue",
      "sheet": "paper/sheet",
      "label": "paper/ink",
      "secondary": "paper/secondary"
    },
    "synq": {
      "ground": "smoke",
      "taskGround": "agents",
      "panel": "smoke/panel",
      "label": "smoke/content"
    },
    "nightshift": {
      "ground": "night",
      "incidentGround": "acid",
      "panel": "console/panel",
      "label": "console/ink"
    }
  },
  "geometry": {
    "space": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ],
    "iconGrid": 24,
    "iconStroke": 1.8,
    "touchTarget": 48,
    "compactPointerTarget": 32,
    "concentricRadius": "max(0, outerRadius - inset)",
    "tabletRail": {
      "edgeInset": 16,
      "width": 72,
      "target": 56,
      "gap": 8,
      "padding": 8,
      "alignment": "leading edge, centered in usable height"
    },
    "breakpoints": {
      "rail": 600,
      "twoPanes": 720,
      "sidebar": 840
    }
  },
  "feedback": {
    "listening": {
      "columns": 9,
      "rows": 3,
      "phaseDelayMs": 550,
      "transitionMs": 110,
      "reducedMotion": "steady matrix with Listening label and Stop action"
    },
    "progress": {
      "columns": 10,
      "rows": 2,
      "value": "show the exact percent next to the grid"
    },
    "goal": {
      "min": 0,
      "max": 100,
      "fill": "saved / target",
      "label": "numeric value and saved amount"
    }
  },
  "interaction": {
    "focus": "use a contrast change in fill and text weight",
    "selection": "label or check plus tint",
    "press": "adjust fill",
    "reducedTransparency": "replace glass with the opaque family panel",
    "status": "pair semantic color with a glyph and a word"
  }
}
